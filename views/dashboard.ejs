<%- include('partials/header', { title: 'Dashboard' }) %>
<%- include('partials/sidebar', { active: 'dashboard' }) %>

<div class="page-head">
  <h1 class="h3 mb-0">Dashboard</h1>
  <span class="text-muted">Overview of the library</span>
</div>

<div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-xl-5 mb-4">
  <div class="col">
    <div class="card stat-card stat-blue h-100">
      <div class="card-body">
        <div class="stat-label">Total Books</div>
        <div class="stat-value"><%= stats.totalBooks %></div>
        <small class="text-muted"><%= stats.availableCopies %> copies available</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card stat-green h-100">
      <div class="card-body">
        <div class="stat-label">Registered Members</div>
        <div class="stat-value"><%= stats.totalMembers %></div>
        <small class="text-muted">Active library members</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card stat-purple h-100">
      <div class="card-body">
        <div class="stat-label">Currently Borrowed</div>
        <div class="stat-value"><%= stats.borrowed %></div>
        <small class="text-muted">Not yet returned</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card stat-red h-100">
      <div class="card-body">
        <div class="stat-label">Overdue Books</div>
        <div class="stat-value"><%= stats.overdue %></div>
        <small class="text-muted">Past the due date</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card stat-orange h-100">
      <div class="card-body">
        <div class="stat-label">Outstanding Fines</div>
        <div class="stat-value"><%= money(stats.outstandingFines) %></div>
        <small class="text-muted">
          <% if (stats.accruingFines > 0) { %>
            + <%= money(stats.accruingFines) %> still growing on overdue books
          <% } else { %>
            Unpaid fines only
          <% } %>
        </small>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>Recent Borrowing Activity</strong>
    <a href="/borrow" class="btn btn-sm btn-primary">Issue / Return Books</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Member</th>
          <th>Book</th>
          <th>Issued</th>
          <th>Due</th>
          <th>Returned</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (recent.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No borrowing activity yet.</td></tr>
        <% } %>
        <% recent.forEach(function (r) { %>
          <tr>
            <td><%= r.member_name %></td>
            <td><%= r.title %></td>
            <td><%= r.issue_date %></td>
            <td><%= r.due_date %></td>
            <td><%= r.return_date || '-' %></td>
            <td><span class="badge bg-<%= statusClass(r.status) %>"><%= r.status %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
